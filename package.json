{
  "name": "malazone",
  "version": "1.0.0",
  "description": "Malazone.com — Zero-Commission Digital Marketplace for Hawassa, Ethiopia",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "server": "nodemon server.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server.js",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "build": "vite build && cd client && npm run build",
    "prod": "NODE_ENV=production node server.js"
  },
  "keywords": [
    "marketplace",
    "ethiopian-commerce",
    "hawassa",
    "zero-commission",
    "property",
    "vehicles",
    "event-halls",
    "machinery-rental",
    "gig-economy"
  ],
  "author": "Luwa Tesemma Kakawo",
  "license": "proprietary",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.19.0",
    "framer-motion": "^10.16.4",
    "helmet": "^7.0.0",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.284.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.16.0",
    "sharp": "^0.32.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.28",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6",
    "vite": "^4.4.9",
    "vite-plugin-pwa": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/malazone/malazone-api.git"
  },
  "bugs": {
    "url": "https://github.com/malazone/malazone-api/issues"
  },
  "homepage": "https://malazone.com"
}
