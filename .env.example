# Malazone.com Environment Variables
# © 2026 Malazone Technologies PLC
#
# Copy this file to .env and fill in real values
# DO NOT commit .env to version control

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4003

# ─────────────────────────────────────────────
# DATABASE (MySQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=malazone

# For production: use managed database service
# DB_HOST=rds-instance.amazonaws.com
# DB_USER=malazone_prod_user
# DB_PASSWORD=use_strong_password_here

# ─────────────────────────────────────────────
# FILE UPLOADS
# ─────────────────────────────────────────────
# Max file size (bytes): 5MB = 5242880
MAX_FILE_SIZE_BYTES=5242880
# Max files per request
MAX_FILES_PER_REQUEST=8
# Upload directory (relative or absolute)
UPLOAD_DIR=./public/uploads

# For production: use S3 or CloudFront
# CDN_BUCKET=malazone-uploads-prod
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_REGION=us-east-1

# ─────────────────────────────────────────────
# CORS & SECURITY
# ─────────────────────────────────────────────
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://malazone.com

# CSRF token secret
CSRF_SECRET=your_random_secret_here_min_32_chars

# Session secret
SESSION_SECRET=your_random_session_secret_here_min_32_chars

# JWT secret
JWT_SECRET=your_random_jwt_secret_here_min_32_chars

# ─────────────────────────────────────────────
# OAUTH PROVIDERS
# ─────────────────────────────────────────────
# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4003/api/auth/google/callback

# ─────────────────────────────────────────────
# EMAIL & NOTIFICATIONS
# ─────────────────────────────────────────────
# For listing verification notifications, seller updates, agent payouts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@malazone.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=Malazone <noreply@malazone.com>

# ─────────────────────────────────────────────
# PAYMENTS & TELEBIRR
# ─────────────────────────────────────────────
# TeleBirr integration (for agent commission payouts)
TELEBIRR_API_KEY=your_telebirr_api_key
TELEBIRR_API_SECRET=your_telebirr_secret
TELEBIRR_MERCHANT_CODE=your_merchant_code
TELEBIRR_SANDBOX=false

# ─────────────────────────────────────────────
# TWILIO (SMS for notifications)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ─────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────
LOG_LEVEL=info
# Sentry error tracking (optional)
SENTRY_DSN=

# ─────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────
ENABLE_AGENTS_PROGRAM=true
ENABLE_VOICE_NOTES=true
ENABLE_PREMIUM_LISTINGS=true
ENABLE_FAVORITES=true

# ─────────────────────────────────────────────
# GEOLOCATION (Hawassa locality verification)
# ─────────────────────────────────────────────
LOCATION_SERVICE=manual
# For future: LOCATION_SERVICE=google, GOOGLE_MAPS_API_KEY=xxx

# ─────────────────────────────────────────────
# CACHING
# ─────────────────────────────────────────────
# Redis for session/cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# TESTING
# ─────────────────────────────────────────────
TEST_DB_HOST=localhost
TEST_DB_NAME=malazone_test

# ─────────────────────────────────────────────
# FRONTEND URLS (for React linking in email)
# ─────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_BASE_URL=http://localhost:3000
